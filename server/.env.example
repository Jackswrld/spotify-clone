# Copy to server/.env and fill in. server/.env is git-ignored.
# Free key: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
RELAY_PORT=4400
# Free token for lyric search: genius.com/api-clients -> New API Client -> Generate Access Token.
GENIUS_ACCESS_TOKEN=
# Only on Vercel (set by the Upstash Redis integration); leave empty locally.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Extra websites allowed to use the relay, comma-separated (your Vercel address is automatic).
# ALLOWED_ORIGINS=
